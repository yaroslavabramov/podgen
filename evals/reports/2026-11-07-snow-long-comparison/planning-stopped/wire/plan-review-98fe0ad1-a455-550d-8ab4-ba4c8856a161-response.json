          "text": "{\n  \"decision\": \"revise\",\n  \"decision_reason\": \"\u041f\u043b\u0430\u043d \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442 \u0441\u0432\u044f\u0437\u043d\u044b\u0439 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0435\u0442\u0435\u043a\u0442\u0438\u0432 \u0438 \u043e\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441 \u0437\u0430\u043a\u0430\u0437\u0447\u0438\u043a\u0430, \u043d\u043e \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430 \u0441\u043e\u0437\u0434\u0430\u0451\u0442 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435, \u0431\u0443\u0434\u0442\u043e \u0432\u0441\u0435 \u0442\u0440\u0438 \u043f\u0440\u0438\u043c\u0435\u0440\u0430 \u0438\u0437 A3 \u0443\u0436\u0435 \u0431\u044b\u043b\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b \u0421\u043d\u043e\u0443 \u0438 \u043b\u0435\u0433\u043b\u0438 \u0432 \u043e\u0441\u043d\u043e\u0432\u0443 \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f 7 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f. \u041a\u0440\u043e\u043c\u0435 \u0442\u043e\u0433\u043e, \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0435\u043c\u0443 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043f\u0440\u0438\u0432\u0435\u0434\u0451\u043d\u043d\u043e\u0435 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u043d\u0435 \u0444\u0438\u043a\u0441\u0438\u0440\u0443\u0435\u0442. \u042d\u0442\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u043c\u043e\u0436\u043d\u043e \u0438\u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043f\u043e \u0438\u043c\u0435\u044e\u0449\u0438\u043c\u0441\u044f \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430\u043c.\",\n  \"listener_answer\": \"\u0421\u043b\u0443\u0448\u0430\u0442\u0435\u043b\u044c \u0441\u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u043e\u0441\u043b\u0435\u0434\u0438\u0442\u044c, \u043a\u0430\u043a \u0421\u043d\u043e\u0443 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u043b \u0432\u043e\u0434\u043d\u043e\u0435 \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435 \u0445\u043e\u043b\u0435\u0440\u044b: \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u043b \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u0443\u043c\u0435\u0440\u0448\u0438\u0445 \u043d\u0430 \u0411\u0440\u043e\u0434-\u0441\u0442\u0440\u0438\u0442, \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043b \u0441\u043c\u0435\u0440\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0441\u043b\u0443\u0447\u0430\u0438 \u0432 \u0434\u043e\u043c\u0430\u0445 \u0441 \u0440\u0430\u0437\u043d\u044b\u043c \u0432\u043e\u0434\u043e\u0441\u043d\u0430\u0431\u0436\u0435\u043d\u0438\u0435\u043c \u0438 \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0441 \u043f\u043e\u0437\u0434\u043d\u0435\u0439\u0448\u0438\u043c \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u043a\u043e\u043b\u043e\u0434\u0446\u0430. \u041d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437\u043d\u044b\u0445 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0439 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043b\u0438 \u0441\u0432\u044f\u0437\u044c \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u0441 \u0437\u0430\u0433\u0440\u044f\u0437\u043d\u0451\u043d\u043d\u043e\u0439 \u0432\u043e\u0434\u043e\u0439, \u0445\u043e\u0442\u044f \u044d\u0444\u0444\u0435\u043a\u0442 \u0441\u043d\u044f\u0442\u0438\u044f \u0440\u0443\u0447\u043a\u0438 \u0438 \u0442\u043e\u0447\u043d\u0430\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0437\u0430\u0433\u0440\u044f\u0437\u043d\u0435\u043d\u0438\u044f \u043a\u043e\u043b\u043e\u0434\u0446\u0430 \u043e\u0441\u0442\u0430\u043b\u0438\u0441\u044c \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u043c\u0438.\",\n  \"strengths\": [\n    {\n      \"targets\": [\n        \"/plan/main_question\",\n        \"/plan/route_summary\",\n        \"/plan/ending/answer_to_deliver\"\n      ],\n      \"reason\": \"\u0413\u043b\u0430\u0432\u043d\u044b\u0439 \u0432\u043e\u043f\u0440\u043e\u0441 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u0437\u0430\u043c\u044b\u0441\u0435\u043b \u0437\u0430\u043a\u0430\u0437\u0447\u0438\u043a\u0430, \u0430 \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0438 \u0444\u0438\u043d\u0430\u043b \u0441\u043e\u0435\u0434\u0438\u043d\u044f\u044e\u0442 \u043c\u0435\u0441\u0442\u043d\u043e\u0435 \u0440\u0430\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435, \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0432\u043e\u0434\u043e\u043f\u0440\u043e\u0432\u043e\u0434\u043d\u044b\u0445 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0439 \u0438 \u043f\u043e\u0437\u0434\u043d\u0435\u0439\u0448\u0443\u044e \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443.\"\n    },\n    {\n      \"targets\": [\n        \"/plan/acts/1/intended_change_in_understanding\",\n        \"/plan/acts/3/intended_change_in_understanding\",\n        \"/plan/acts/4/intended_change_in_understanding\"\n      ],\n      \"reason\": \"\u041f\u043b\u0430\u043d \u043e\u0431\u044a\u044f\u0441\u043d\u044f\u0435\u0442 \u043d\u0435\u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0443, \u043f\u043e\u0447\u0435\u043c\u0443 \u0430\u0434\u0440\u0435\u0441 \u043d\u0435 \u0440\u0430\u0432\u0435\u043d \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u043c\u0443 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044e \u0432\u043e\u0434\u044b, \u043f\u043e\u0447\u0435\u043c\u0443 \u043d\u0430\u0447\u0430\u043b\u043e \u0431\u043e\u043b\u0435\u0437\u043d\u0438 \u043e\u0442\u043b\u0438\u0447\u0430\u0435\u0442\u0441\u044f \u043e\u0442 \u0434\u0430\u0442\u044b \u0441\u043c\u0435\u0440\u0442\u0438 \u0438 \u0437\u0430\u0447\u0435\u043c \u0447\u0438\u0441\u043b\u043e \u0441\u043c\u0435\u0440\u0442\u0435\u0439 \u0441\u043e\u043f\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u0441 \u0447\u0438\u0441\u043b\u043e\u043c \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u043c\u044b\u0445 \u0434\u043e\u043c\u043e\u0432.\"\n    },\n    {\n      \"targets\": [\n        \"/plan/acts/5/intended_change_in_understanding\",\n        \"/plan/host_functions/0/contribution\"\n      ],\n      \"reason\": \"\u041f\u043e\u0437\u0434\u043d\u0435\u0435 \u0440\u0430\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u043e \u043a\u0430\u043a \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0440\u0430\u0441\u0441\u043f\u0440\u043e\u0441\u043e\u0432, \u043e\u0441\u043c\u043e\u0442\u0440\u0430 \u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u043e\u0433\u043e \u0432\u043e\u0437\u0440\u0430\u0436\u0435\u043d\u0438\u044f; \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0447\u0438\u043a\u0443 \u043f\u043e\u0440\u0443\u0447\u0435\u043d\u043e \u0440\u0430\u0437\u043b\u0438\u0447\u0430\u0442\u044c \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f, \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0441\u0435\u043c\u0435\u0439 \u0438 \u0432\u044b\u0432\u043e\u0434\u044b \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439.\"\n    }\n  ],\n  \"findings\": [\n    {\n      \"targets\": [\n        \"/plan/route_summary\",\n        \"/plan/acts/2/intended_change_in_understanding\",\n        \"/plan/acts/2/transitions/toward_next\",\n        \"/plan/acts/3/transitions/from_previous\"\n      ],\n      \"priority\": \"important\",\n      \"observation\": \"\u0420\u0430\u0431\u043e\u0442\u043d\u044b\u0439 \u0434\u043e\u043c, \u043f\u0438\u0432\u043e\u0432\u0430\u0440\u043d\u044f \u0438 \u0441\u043b\u0443\u0447\u0430\u0439 \u0436\u0435\u043d\u0449\u0438\u043d\u044b \u0438\u0437 \u0425\u044d\u043c\u043f\u0441\u0442\u0435\u0434\u0430 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u044b \u043f\u0435\u0440\u0435\u0434 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435\u043c \u043a \u0437\u0430\u0441\u0435\u0434\u0430\u043d\u0438\u044e, \u043f\u043e\u0441\u043b\u0435 \u0447\u0435\u0433\u043e \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u044b \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u044e\u0442 \u0441\u0432\u0435\u0441\u0442\u0438 \u044d\u0442\u0438 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u0432 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f. \u042d\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u0451\u0442 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435, \u0447\u0442\u043e \u0421\u043d\u043e\u0443 \u0440\u0430\u0441\u043f\u043e\u043b\u0430\u0433\u0430\u043b \u0432\u0441\u0435\u043c\u0438 \u0442\u0440\u0435\u043c\u044f \u043f\u0440\u0438\u043c\u0435\u0440\u0430\u043c\u0438 7 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f, \u0445\u043e\u0442\u044f \u0432\u0440\u0435\u043c\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u044d\u0442\u0438\u0445 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u0439 \u043d\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e.\",\n      \"requested_change\": \"\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0442\u0440\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438, \u043d\u043e \u043e\u0442\u0434\u0435\u043b\u0438\u0442\u044c \u0438\u0445 \u043e\u0442 \u0434\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0421\u043d\u043e\u0443 \u0441\u0430\u043c \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u0442 \u0441\u043e \u0432\u0441\u0442\u0440\u0435\u0447\u0435\u0439 7 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u043a \u0437\u0430\u0441\u0435\u0434\u0430\u043d\u0438\u044e \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u0440\u0430\u0441\u0441\u043f\u0440\u043e\u0441\u043e\u0432 \u043e 83 \u0441\u043c\u0435\u0440\u0442\u044f\u0445, \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043f\u0440\u0438\u043c\u0435\u0440\u044b \u043a\u0430\u043a \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0421\u043d\u043e\u0443 \u043f\u043e\u0437\u0434\u043d\u0435\u0435, \u043d\u0435 \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u044f \u0438\u0445 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0439 \u0434\u0430\u0442\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f.\",\n      \"preserve\": [\n        \"\u041a\u043e\u043d\u0442\u0440\u0430\u0441\u0442 \u0440\u0430\u0431\u043e\u0442\u043d\u043e\u0433\u043e \u0434\u043e\u043c\u0430 \u0438 \u043f\u0438\u0432\u043e\u0432\u0430\u0440\u043d\u0438 \u0441 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0438\u043c \u0440\u0430\u0439\u043e\u043d\u043e\u043c \u0438 \u043e\u0433\u043e\u0432\u043e\u0440\u043a\u0443 \u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0438 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u0439 \u043e\u0442 \u0425\u0430\u0433\u0433\u0438\u043d\u0441\u0430.\",\n        \"\u0425\u044d\u043c\u043f\u0441\u0442\u0435\u0434\u0441\u043a\u0438\u0439 \u0441\u043b\u0443\u0447\u0430\u0439 \u043a\u0430\u043a \u0440\u0430\u0441\u0441\u043a\u0430\u0437 \u0441\u044b\u043d\u0430 \u043e \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0439 \u0432\u043e\u0434\u0435, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u0435 \u0438\u0441\u0445\u043e\u0434\u043e\u0432 \u0443 \u043f\u0438\u0432\u0448\u0438\u0445 \u0435\u0451 \u043b\u044e\u0434\u0435\u0439.\",\n        \"\u0421\u0432\u044f\u0437\u044c \u043e\u0431\u0440\u0430\u0449\u0435\u043d\u0438\u044f \u043a \u043f\u043e\u043f\u0435\u0447\u0438\u0442\u0435\u043b\u044f\u043c \u0441 \u0440\u0430\u0441\u0441\u043f\u0440\u043e\u0441\u0430\u043c\u0438 \u043e\u0431 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0438 \u0432\u043e\u0434\u044b, \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043d\u0443\u044e \u0441\u0430\u043c\u0438\u043c \u0421\u043d\u043e\u0443.\"\n      ],\n      \"material_refs\": [\n        \"M1\",\n        \"M4\",\n        \"M5\",\n        \"M6\",\n        \"M7\"\n      ]\n    },\n    {\n      \"targets\": [\n        \"/plan/opening/approach\",\n        \"/plan/opening/question_to_open\",\n        \"/plan/acts/0/transitions/from_previous\"\n      ],\n      \"priority\": \"important\",\n      \"observation\": \"\u041e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0441\u043e\u043e\u0431\u0449\u0430\u0435\u0442, \u0447\u0442\u043e \u0421\u043d\u043e\u0443 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u043b \u043f\u0440\u0435\u043a\u0440\u0430\u0442\u0438\u0442\u044c \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043a\u043e\u043b\u043e\u043d\u043a\u043e\u0439, \u0430 \u043f\u0435\u0440\u0435\u0445\u043e\u0434 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u044d\u0442\u043e \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0435\u043c. \u0412 \u043f\u0440\u0438\u0432\u0435\u0434\u0451\u043d\u043d\u043e\u043c \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0435 \u0421\u043d\u043e\u0443 \u0441\u043a\u0430\u0437\u0430\u043d\u043e, \u0447\u0442\u043e \u043e\u043d \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u043f\u043e\u043f\u0435\u0447\u0438\u0442\u0435\u043b\u044f\u043c \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430 \u0438 \u0432\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u0433\u043e \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0434\u0435\u043d\u044c \u0441\u043d\u044f\u043b\u0438 \u0440\u0443\u0447\u043a\u0443; \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0430\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u0430 \u0438\u043b\u0438 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0435 \u0437\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u044b.\",\n      \"requested_change\": \"\u041f\u043e\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0441\u0446\u0435\u043d\u0443 \u0438 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u044e\u0449\u0438\u0439 \u0432\u043e\u043f\u0440\u043e\u0441 \u0432\u043e\u043a\u0440\u0443\u0433 \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0421\u043d\u043e\u0443 \u0438\u0437\u043b\u043e\u0436\u0438\u043b \u043f\u043e\u043f\u0435\u0447\u0438\u0442\u0435\u043b\u044f\u043c, \u0438 \u0438\u0445 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044f, \u043d\u0435 \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u044f \u0435\u043c\u0443 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e \u043d\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u0443\u044e \u0444\u043e\u0440