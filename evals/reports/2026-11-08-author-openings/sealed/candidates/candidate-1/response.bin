          "text": "{\"utterances\":[{\"speaker\":\"\u0420\u0410\u0421\u0421\u041a\u0410\u0417\u0427\u0418\u041a\",\"text\":\"\u0412 \u043d\u043e\u0447\u044c \u0441 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044c \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0430\u0432\u0433\u0443\u0441\u0442\u0430 \u043d\u0430 \u043f\u0435\u0440\u0432\u043e\u0435 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f 1854 \u0433\u043e\u0434\u0430 \u0432 \u043b\u043e\u043d\u0434\u043e\u043d\u0441\u043a\u043e\u043c \u0440\u0430\u0439\u043e\u043d\u0435 \u0411\u0440\u043e\u0434-\u0441\u0442\u0440\u0438\u0442 \u0440\u0435\u0437\u043a\u043e \u0440\u0430\u0441\u0442\u0451\u0442 \u0447\u0438\u0441\u043b\u043e \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0448\u0438\u0445 \u0445\u043e\u043b\u0435\u0440\u043e\u0439. \u0417\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u043d\u0435\u0439 \u0437\u0434\u0435\u0441\u044c \u0443\u043c\u0438\u0440\u0430\u044e\u0442 \u0434\u0435\u0441\u044f\u0442\u043a\u0438 \u043b\u044e\u0434\u0435\u0439. \u0410 \u0432\u0435\u0447\u0435\u0440\u043e\u043c \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f \u0432\u0440\u0430\u0447 \u0414\u0436\u043e\u043d \u0421\u043d\u043e\u0443 \u0440\u0430\u0441\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0432\u043e\u0434\u0443 \u0438\u0437 \u043c\u0435\u0441\u0442\u043d\u043e\u0439 \u0443\u043b\u0438\u0447\u043d\u043e\u0439 \u043a\u043e\u043b\u043e\u043d\u043a\u0438. \u041e\u043d \u0443\u0436\u0435 \u043f\u043e\u0434\u043e\u0437\u0440\u0435\u0432\u0430\u0435\u0442 \u044d\u0442\u043e\u0442 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a. \u041d\u043e \u0432\u043e\u0434\u0430 \u043d\u0435 \u0441\u043f\u0435\u0448\u0438\u0442 \u0432\u044b\u0434\u0430\u0432\u0430\u0442\u044c \u0441\u0435\u0431\u044f.\"},{\"speaker\":\"\u0420\u0410\u0421\u0421\u041a\u0410\u0417\u0427\u0418\u041a\",\"text\":\"\u0412 \u043d\u0435\u0439 \u043c\u0430\u043b\u043e \u0432\u0438\u0434\u0438\u043c\u043e\u0439 \u043e\u0440\u0433\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0440\u0438\u043c\u0435\u0441\u0438. \u041d\u0438\u0447\u0435\u0433\u043e \u0442\u0430\u043a\u043e\u0433\u043e, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u043b\u043e \u0431\u044b \u0441\u0440\u0430\u0437\u0443 \u0441\u043a\u0430\u0437\u0430\u0442\u044c: \u0432\u043e\u0442 \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435 \u0441\u043c\u0435\u0440\u0442\u0435\u0439. \u0421\u043d\u043e\u0443 \u043a\u043e\u043b\u0435\u0431\u043b\u0435\u0442\u0441\u044f. \u0412 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0434\u0432\u0430 \u0434\u043d\u044f \u043e\u043d \u0441\u043d\u043e\u0432\u0430 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442 \u0432\u043e\u0434\u0443. \u0411\u0435\u043b\u043e\u0432\u0430\u0442\u044b\u0435 \u0445\u043b\u043e\u043f\u044c\u044f \u0442\u043e \u043f\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0432 \u0431\u043e\u043b\u044c\u0448\u0435\u043c \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435, \u0442\u043e \u0432 \u043c\u0435\u043d\u044c\u0448\u0435\u043c. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0432 \u043d\u0430\u0447\u0430\u043b\u0435 \u0432\u0441\u043f\u044b\u0448\u043a\u0438 \u0432\u043e\u0434\u0430 \u0431\u044b\u043b\u0430 \u0433\u0440\u044f\u0437\u043d\u0435\u0435. \u041d\u043e \u044d\u0442\u043e \u043f\u043e\u043a\u0430 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435. \u041f\u0435\u0440\u0435\u0434 \u043d\u0438\u043c \u043f\u0440\u043e\u0431\u0430, \u0432\u0437\u044f\u0442\u0430\u044f \u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u043b\u044e\u0434\u0438 \u043d\u0430\u0447\u0430\u043b\u0438 \u0437\u0430\u0431\u043e\u043b\u0435\u0432\u0430\u0442\u044c. \u041a\u0430\u043a \u043f\u043e \u043d\u0435\u0439 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c, \u0447\u0442\u043e \u043e\u043d\u0438 \u043f\u0438\u043b\u0438 \u0440\u0430\u043d\u044c\u0448\u0435?\"},{\"speaker\":\"\u0420\u0410\u0421\u0421\u041a\u0410\u0417\u0427\u0418\u041a\",\"text\":\"\u041a\u043e\u043b\u043e\u043d\u043a\u0430 \u043d\u0430 \u0411\u0440\u043e\u0434-\u0441\u0442\u0440\u0438\u0442 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u0430. \u0417\u0430 \u0432\u043e\u0434\u043e\u0439 \u0441\u044e\u0434\u0430 \u043f\u0440\u0438\u0445\u043e\u0434\u044f\u0442 \u0441 \u0432\u0451\u0434\u0440\u0430\u043c\u0438 \u0438 \u0434\u0440\u0443\u0433\u043e\u0439 \u043f\u043e\u0441\u0443\u0434\u043e\u0439, \u0447\u0442\u043e\u0431\u044b \u0443\u043d\u0435\u0441\u0442\u0438 \u0435\u0451 \u0434\u043e\u043c\u043e\u0439. \u042d\u0442\u043e \u0432\u0430\u0436\u043d\u0430\u044f \u0431\u044b\u0442\u043e\u0432\u0430\u044f \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0441\u0442\u044c: \u0447\u0435\u043b\u043e\u0432\u0435\u043a \u043c\u043e\u0436\u0435\u0442 \u0436\u0438\u0442\u044c \u043d\u0430 \u043e\u0434\u043d\u043e\u0439 \u0443\u043b\u0438\u0446\u0435, \u0430 \u043f\u0438\u0442\u044c \u0432\u043e\u0434\u0443 \u0441 \u0434\u0440\u0443\u0433\u043e\u0439. \u0418 \u0434\u0430\u0436\u0435 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u0434\u0430\u043b\u044c\u043d\u044e\u044e \u043a\u043e\u043b\u043e\u043d\u043a\u0443 \u0442\u043e\u0439, \u0447\u0442\u043e \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432\u043e\u0437\u043b\u0435 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u043e\u0440\u043e\u0433\u0430.\"},{\"speaker\":\"\u0420\u0410\u0421\u0421\u041a\u0410\u0417\u0427\u0418\u041a\",\"text\":\"\u0417\u043d\u0430\u0447\u0438\u0442, \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043d\u0430 \u0432\u043e\u0434\u0443. \u0418 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0443\u0437\u043d\u0430\u0442\u044c, \u0432\u043e\u0437\u043b\u0435 \u043a\u0430\u043a\u0438\u0445 \u0434\u043e\u043c\u043e\u0432 \u0441\u0442\u043e\u044f\u0442 \u0433\u0440\u043e\u0431\u044b. \u041d\u0443\u0436\u043d\u043e \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043f\u0440\u0438\u0432\u044b\u0447\u043a\u0438 \u043b\u044e\u0434\u0435\u0439: \u043a\u0443\u0434\u0430 \u043e\u043d\u0438 \u0445\u043e\u0434\u0438\u043b\u0438 \u0437\u0430 \u0432\u043e\u0434\u043e\u0439, \u043e\u0442\u043a\u0443\u0434\u0430 \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u043b\u0438 \u0435\u0451 \u0434\u0435\u0442\u044f\u043c, \u0447\u0442\u043e \u043f\u0438\u043b\u0438 \u043d\u0435\u0437\u0430\u0434\u043e\u043b\u0433\u043e \u0434\u043e \u0431\u043e\u043b\u0435\u0437\u043d\u0438. \u0420\u0430\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0430\u0435\u0442\u0441\u044f \u043e\u0442 \u043a\u043e\u043b\u043e\u043d\u043a\u0438 \u043a \u0434\u0432\u0435\u0440\u044f\u043c \u0434\u043e\u043c\u043e\u0432.\"},{\"speaker\":\"\u0420\u0410\u0421\u0421\u041a\u0410\u0417\u0427\u0418\u041a\",\"text\":\"\u0421\u043d\u043e\u0443 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0432 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u043c \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438 \u0441\u043f\u0438\u0441\u043e\u043a \u0441\u043c\u0435\u0440\u0442\u0435\u0439 \u043e\u0442 \u0445\u043e\u043b\u0435\u0440\u044b. \u0414\u043b\u044f \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e\u0439 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u043e\u043d \u0431\u0435\u0440\u0451\u0442 \u0432\u043e\u0441\u0435\u043c\u044c\u0434\u0435\u0441\u044f\u0442 \u0442\u0440\u0438 \u0441\u043b\u0443\u0447\u0430\u044f \u2014 \u0441\u043c\u0435\u0440\u0442\u0438 \u0437\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0442\u0440\u0438 \u0434\u043d\u044f \u043d\u0435\u0434\u0435\u043b\u0438, \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0432\u0448\u0435\u0439\u0441\u044f \u0432\u0442\u043e\u0440\u043e\u0433\u043e \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f. \u0422\u0435\u043f\u0435\u0440\u044c \u0443 \u043d\u0435\u0433\u043e \u0435\u0441\u0442\u044c \u0438\u043c\u0435\u043d\u0430 \u0438 \u0430\u0434\u0440\u0435\u0441\u0430. \u041d\u043e \u0430\u0434\u0440\u0435\u0441 \u2014 \u043b\u0438\u0448\u044c \u043d\u0430\u0447\u0430\u043b\u043e \u0441\u043b\u0435\u0434\u0430. \u0421\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0432\u043e\u043f\u0440\u043e\u0441 \u043f\u0440\u0438\u0434\u0451\u0442\u0441\u044f \u0437\u0430\u0434\u0430\u0432\u0430\u0442\u044c \u0436\u0438\u0432\u044b\u043c: \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0441\u044f \u043b\u0438 \u0443\u043c\u0435\u0440\u0448\u0438\u0439 \u0432\u043e\u0434\u043e\u0439 \u0441 \u0411\u0440\u043e\u0434-\u0441\u0442\u0440\u0438\u0442?\"}]}"
        }
      ],
