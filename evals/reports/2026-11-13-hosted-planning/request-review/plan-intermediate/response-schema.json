{
  "type": "json_schema",
  "name": "plan",
  "schema": {
    "$defs": {
      "PlanProposalV9": {
        "additionalProperties": false,
        "properties": {
          "main_question": {
            "minLength": 1,
            "title": "Main Question",
            "type": "string",
            "description": "The central question of the selected story for this audience; preserve an explicit client question, and prepare the premises a newcomer needs to follow it."
          },
          "listener_promise": {
            "minLength": 1,
            "title": "Listener Promise",
            "type": "string",
            "description": "What following the chosen story offers this audience."
          },
          "working_answer": {
            "description": "The supported answer or meaning established across the whole episode, including uncertainty that changes it. This is planning meaning, not ready-made spoken lines.",
            "minLength": 1,
            "title": "Working Answer",
            "type": "string"
          },
          "route_summary": {
            "description": "The selected story from its prepared opening through connected developments and the final act. Select or combine branches that repeat the same contribution; keep event chronology and the timing of discoveries accurate.",
            "minLength": 1,
            "title": "Route Summary",
            "type": "string"
          },
          "opening": {
            "$ref": "#/$defs/PlanningOpening"
          },
          "acts": {
            "items": {
              "$ref": "#/$defs/PlanningAct"
            },
            "minItems": 1,
            "title": "Acts",
            "type": "array"
          },
          "ending": {
            "$ref": "#/$defs/PlanningFinalMoment"
          },
          "host_functions": {
            "items": {
              "$ref": "#/$defs/PlanningHostFunction"
            },
            "minItems": 1,
            "title": "Host Functions",
            "type": "array"
          },
          "duration_strategy": {
            "$ref": "#/$defs/PlanningDurationStrategy"
          }
        },
        "required": [
          "main_question",
          "listener_promise",
          "working_answer",
          "route_summary",
          "opening",
          "acts",
          "ending",
          "host_functions",
          "duration_strategy"
        ],
        "title": "PlanProposalV9",
        "type": "object"
      },
      "PlanningAct": {
        "additionalProperties": false,
        "properties": {
          "act_id": {
            "description": "Short local act label.",
            "minLength": 1,
            "title": "Act Id",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string",
            "description": "A short name for this part of the chosen story."
          },
          "listener_question": {
            "minLength": 1,
            "title": "Listener Question",
            "type": "string",
            "description": "What listeners want to find out at this point in the story."
          },
          "intended_change_in_understanding": {
            "minLength": 1,
            "title": "Intended Change In Understanding",
            "type": "string",
            "description": "What happens, is discovered, or becomes clear in this part."
          },
          "prerequisite_concepts": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Prerequisite Concepts",
            "type": "array",
            "description": "Situational premises or concepts this audience needs before following this part; establish them earlier or introduce them before the dependent question or discovery. Empty is valid when none are needed."
          },
          "material_refs": {
            "description": "Exact supplied locators supporting this act's reasoning.",
            "items": {
              "minLength": 1,
              "type": "string",
              "enum": [
                "M1",
                "M2",
                "M3",
                "M4",
                "M5",
                "M6",
                "M7",
                "M8",
                "M9",
                "M10"
              ]
            },
            "title": "Material Refs",
            "type": "array"
          },
          "transitions": {
            "$ref": "#/$defs/PlanningTransitions"
          },
          "promises_opened": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Promises Opened",
            "type": "array"
          },
          "promises_addressed": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Promises Addressed",
            "type": "array"
          },
          "estimated_seconds_range": {
            "$ref": "#/$defs/PlanningSecondsRange"
          },
          "priority": {
            "enum": [
              "essential",
              "optional"
            ],
            "title": "Priority",
            "type": "string"
          }
        },
        "required": [
          "act_id",
          "title",
          "listener_question",
          "intended_change_in_understanding",
          "prerequisite_concepts",
          "material_refs",
          "transitions",
          "promises_opened",
          "promises_addressed",
          "estimated_seconds_range",
          "priority"
        ],
        "title": "PlanningAct",
        "type": "object"
      },
      "PlanningDurationStrategy": {
        "additionalProperties": false,
        "properties": {
          "estimated_seconds_range": {
            "$ref": "#/$defs/PlanningSecondsRange"
          },
          "assumptions": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Assumptions",
            "type": "array",
            "description": "The timing basis for the duration estimate, such as pace, pauses, and how the parts are counted."
          },
          "optional_material": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Optional Material",
            "type": "array",
            "description": "Specific story material that can be added or removed to fit the duration; an empty list is valid."
          }
        },
        "required": [
          "estimated_seconds_range",
          "assumptions",
          "optional_material"
        ],
        "title": "PlanningDurationStrategy",
        "type": "object"
      },
      "PlanningFinalMoment": {
        "additionalProperties": false,
        "properties": {
          "last_moment": {
            "description": "Selected ending content for the writer; composition and spoken wording remain the writer's task.",
            "minLength": 1,
            "title": "Last Moment",
            "type": "string"
          },
          "why_end_here": {
            "description": "Why this content fits the whole story and what listeners already understand from the preceding passage.",
            "minLength": 1,
            "title": "Why End Here",
            "type": "string"
          },
          "promises_to_close": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Promises To Close",
            "type": "array",
            "description": "Questions answered during the episode; their answers need not be repeated in the ending."
          }
        },
        "required": [
          "last_moment",
          "why_end_here",
          "promises_to_close"
        ],
        "title": "PlanningFinalMoment",
        "type": "object"
      },
      "PlanningHostFunction": {
        "additionalProperties": false,
        "properties": {
          "speaker_id": {
            "description": "Exact speaker label from the assignment.",
            "minLength": 1,
            "title": "Speaker Id",
            "type": "string"
          },
          "contribution": {
            "minLength": 1,
            "title": "Contribution",
            "type": "string",
            "description": "What this person tells, explains, notices, asks, or contributes to this particular story."
          },
          "interaction_guidance": {
            "minLength": 1,
            "title": "Interaction Guidance",
            "type": "string",
            "description": "How this narrator carries the account forward, or how the speakers' contributions build on each other."
          },
          "speech_register": {
            "minLength": 1,
            "title": "Speech Register",
            "type": "string",
            "description": "How this person speaks for this audience and genre."
          }
        },
        "required": [
          "speaker_id",
          "contribution",
          "interaction_guidance",
          "speech_register"
        ],
        "title": "PlanningHostFunction",
        "type": "object"
      },
      "PlanningOpening": {
        "additionalProperties": false,
        "properties": {
          "approach": {
            "minLength": 1,
            "title": "Approach",
            "type": "string",
            "description": "What listeners encounter at the start, what they learn or notice next, and how this opens the chosen story."
          },
          "material_refs": {
            "description": "Exact locators offered in the supplied material catalog.",
            "items": {
              "minLength": 1,
              "type": "string",
              "enum": [
                "M1",
                "M2",
                "M3",
                "M4",
                "M5",
                "M6",
                "M7",
                "M8",
                "M9",
                "M10"
              ]
            },
            "title": "Material Refs",
            "type": "array"
          },
          "question_to_open": {
            "minLength": 1,
            "title": "Question To Open",
            "type": "string",
            "description": "The question raised for listeners by this opening."
          }
        },
        "required": [
          "approach",
          "material_refs",
          "question_to_open"
        ],
        "title": "PlanningOpening",
        "type": "object"
      },
      "PlanningResearchRequest": {
        "additionalProperties": false,
        "properties": {
          "question": {
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "why_needed": {
            "minLength": 1,
            "title": "Why Needed",
            "type": "string"
          },
          "affected_act_ids": {
            "description": "Local act labels; empty for an episode-wide question.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Affected Act Ids",
            "type": "array"
          },
          "material_refs": {
            "description": "Relevant supplied locators; may be empty for missing evidence.",
            "items": {
              "minLength": 1,
              "type": "string",
              "enum": [
                "M1",
                "M2",
                "M3",
                "M4",
                "M5",
                "M6",
                "M7",
                "M8",
                "M9",
                "M10"
              ]
            },
            "title": "Material Refs",
            "type": "array"
          },
          "blocking": {
            "description": "Whether the promised answer requires this unresolved material.",
            "title": "Blocking",
            "type": "boolean"
          }
        },
        "required": [
          "question",
          "why_needed",
          "affected_act_ids",
          "material_refs",
          "blocking"
        ],
        "title": "PlanningResearchRequest",
        "type": "object"
      },
      "PlanningSecondsRange": {
        "additionalProperties": false,
        "properties": {
          "min_seconds": {
            "minimum": 0,
            "title": "Min Seconds",
            "type": "integer"
          },
          "max_seconds": {
            "minimum": 0,
            "title": "Max Seconds",
            "type": "integer"
          }
        },
        "required": [
          "min_seconds",
          "max_seconds"
        ],
        "title": "PlanningSecondsRange",
        "type": "object"
      },
      "PlanningTransitions": {
        "additionalProperties": false,
        "properties": {
          "from_previous": {
            "minLength": 1,
            "title": "From Previous",
            "type": "string",
            "description": "How the preceding development leads into this part."
          },
          "toward_next": {
            "minLength": 1,
            "title": "Toward Next",
            "type": "string",
            "description": "How this part leads to the next development or question."
          }
        },
        "required": [
          "from_previous",
          "toward_next"
        ],
        "title": "PlanningTransitions",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "status": {
        "enum": [
          "ready",
          "needs_research"
        ],
        "title": "Status",
        "type": "string"
      },
      "plan": {
        "anyOf": [
          {
            "$ref": "#/$defs/PlanProposalV9"
          },
          {
            "type": "null"
          }
        ],
        "description": "Complete selected story, or null when material cannot support one."
      },
      "research_requests": {
        "items": {
          "$ref": "#/$defs/PlanningResearchRequest"
        },
        "title": "Research Requests",
        "type": "array"
      }
    },
    "required": [
      "status",
      "plan",
      "research_requests"
    ],
    "title": "PlanningOutputV9",
    "type": "object"
  },
  "strict": true
}
