"bibliography_status\":\"source_catalog_metadata_not_claim_evidence\"},{\"source\":\"bonhams.com\",\"source_id\":\"S60\",\"status\":\"not_acquired\",\"retained_version\":null,\"title_origin\":\"reported_label\",\"length\":null,\"reported_citation_number\":60,\"resolved_url\":null,\"coverage\":null,\"limitations\":[],\"bibliography_status\":\"source_catalog_metadata_not_claim_evidence\"},{\"source\":\"Link\",\"source_id\":\"S61\",\"status\":\"not_acquired\",\"retained_version\":null,\"title_origin\":\"reported_label\",\"length\":null,\"reported_citation_number\":61,\"resolved_url\":null,\"coverage\":null,\"limitations\":[],\"bibliography_status\":\"source_catalog_metadata_not_claim_evidence\"},{\"source\":\"quora.com\",\"source_id\":\"S62\",\"status\":\"not_acquired\",\"retained_version\":null,\"title_origin\":\"reported_label\",\"length\":null,\"reported_citation_number\":62,\"resolved_url\":null,\"coverage\":null,\"limitations\":[],\"bibliography_status\":\"source_catalog_metadata_not_claim_evidence\"}],\"research_cautions\":[{\"note\":\"marker_disabled_text_layer_only\",\"source_id\":\"S4\"},{\"note\":\"pdf_text_layer_only_no_ocr\",\"source_id\":\"S4\"},{\"note\":\"TimeoutError:\",\"source_id\":\"S13\"},{\"note\":\"TimeoutError:\",\"source_id\":\"S24\"},{\"note\":\"marker_disabled_text_layer_only\",\"source_id\":\"S26\"},{\"note\":\"pdf_text_layer_only_no_ocr\",\"source_id\":\"S26\"},{\"note\":\"The retained representation contains the chapter summary and metadata, not the complete chapter.\",\"source_id\":\"S39\"},{\"note\":\"javascript_challenge\",\"source_id\":\"S41\"},{\"note\":\"http_status_403\",\"source_id\":\"S41\"},{\"note\":\"javascript_challenge\",\"source_id\":\"S48\"},{\"note\":\"http_status_403\",\"source_id\":\"S48\"},{\"note\":\"cloudfront_error_page\",\"source_id\":\"S55\"},{\"note\":\"access_denied\",\"source_id\":\"S55\"},{\"note\":\"http_status_403\",\"source_id\":\"S55\"}]}",
