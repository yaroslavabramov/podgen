# Database
DATABASE_URL=postgresql+asyncpg://podgen:podgen@localhost:5432/podgen
DATABASE_URL_SYNC=postgresql://podgen:podgen@localhost:5432/podgen

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=podgen
MINIO_SECURE=false

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=podgen_chunks

# LLM Providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ElevenLabs
ELEVENLABS_API_KEY=...

# Tavily (web search)
TAVILY_API_KEY=tvly-...

# Jina Reader
JINA_API_KEY=jina_...

# Deepgram
DEEPGRAM_API_KEY=...

# Auth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256

# API
API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
