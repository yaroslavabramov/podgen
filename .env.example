# Database
DATABASE_URL=postgresql+asyncpg://podgen:podgen@localhost:5432/podgen
DATABASE_URL_SYNC=postgresql://podgen:podgen@localhost:5432/podgen

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=podgen
MINIO_SECURE=false

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=podgen_chunks

# LLM Providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
SHOWRUNNER_GENERATION_PROVIDER=anthropic
SHOWRUNNER_OPENAI_MODEL=gpt-5.4
SHOWRUNNER_OPENAI_REASONING_EFFORT=medium
GENERATION_V2_OPENAI_MODEL=gpt-5
GENERATION_V2_OPENAI_REASONING_EFFORT=medium
GENERATION_V2_ENABLE_PROVIDER_UPLOADS=true
GENERATION_V2_ENABLE_WEB_SEARCH_RESEARCH=true
GENERATION_V2_ENABLE_RENDERED_SNAPSHOTS=true
GENERATION_V2_CLEANUP_PROVIDER_FILES=false
GENERATION_V2_ALLOW_RUNTIME_FALLBACK=false
GENERATION_V2_ALLOW_FALLBACK_AUDIO=false

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=podgen
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_BASE_TAGS=podgen,backend
LANGSMITH_SAMPLING_RATE=1.0

# ElevenLabs
ELEVENLABS_API_KEY=...

# Tavily (web search)
TAVILY_API_KEY=tvly-...

# Jina Reader
JINA_API_KEY=jina_...
WEB_QUALITY_GATE_A_MIN_CHARS=160
WEB_DATE_EXTRACTION_MIN_PREVIEW_CHARS=80
WEB_USER_AGENT="PodgenIngestionBot/1.0 (+https://example.com/podgen; ingest@podgen.local)"
WEB_ACCEPT_LANGUAGE="en-US,en;q=0.9"
WEB_DNS_RESOLVE_RETRIES=3
WEB_DNS_RESOLVE_RETRY_DELAY_MS=250
WEB_EXTRACTOR_DEBUG_DUMP_DIR=""
GENERATION_V2_DEBUG_DUMP_DIR=""

# Deepgram
DEEPGRAM_API_KEY=...

# Auth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256

# API
API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
