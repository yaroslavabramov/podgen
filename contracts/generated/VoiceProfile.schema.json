{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "EpisodeSpec",
            "PolicyBundle",
            "Policy",
            "PromptDefinition",
            "ToolsetDefinition",
            "ModelProfile",
            "CapabilityReport",
            "ProcessingProfile",
            "SourceRevision",
            "SourceRepresentation",
            "EvidenceSpan",
            "SourceRelation",
            "SourceFamilyAssessment",
            "DerivedPreview",
            "ResearchNote",
            "QuestionRecord",
            "UncertaintyRecord",
            "DossierSnapshot",
            "EditorialState",
            "EditorialDecision",
            "ResearchRequest",
            "StoryPlan",
            "ScriptRevision",
            "ScriptChangeSet",
            "ListenerState",
            "ClaimSet",
            "VerificationReport",
            "EditorialReview",
            "CalculationRecord",
            "ShowNotes",
            "ShowNotesReview",
            "VoiceProfile",
            "PronunciationLexicon",
            "PerformancePlan",
            "AudioSegment",
            "AudioMaster",
            "Transcript",
            "AudioQAReport",
            "ReleaseManifest",
            "EvaluationCase",
            "EvaluationResult",
            "EvaluationAnnotation",
            "HumanAssessment",
            "DiagnosticArtifact"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "revision_id",
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "provider_voice_id": {
      "minLength": 1,
      "title": "Provider Voice Id",
      "type": "string"
    },
    "provider_revision_or_alias": {
      "minLength": 1,
      "title": "Provider Revision Or Alias",
      "type": "string"
    },
    "model_profile_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "language_locales": {
      "items": {
        "type": "string"
      },
      "title": "Language Locales",
      "type": "array"
    },
    "voice_kind": {
      "enum": [
        "stock",
        "authorized_custom"
      ],
      "title": "Voice Kind",
      "type": "string"
    },
    "authorization_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "usage_policy_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "provider",
    "provider_voice_id",
    "provider_revision_or_alias",
    "model_profile_ref",
    "language_locales",
    "voice_kind",
    "authorization_ref",
    "usage_policy_ref",
    "limitations"
  ],
  "title": "VoiceProfile",
  "type": "object",
  "$id": "urn:podgen:VoiceProfile:1.0"
}
