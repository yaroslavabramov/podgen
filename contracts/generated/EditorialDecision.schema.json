{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "EpisodeSpec",
            "PolicyBundle",
            "Policy",
            "PromptDefinition",
            "ToolsetDefinition",
            "ModelProfile",
            "CapabilityReport",
            "ProcessingProfile",
            "SourceRevision",
            "SourceRepresentation",
            "EvidenceSpan",
            "SourceRelation",
            "SourceFamilyAssessment",
            "DerivedPreview",
            "ResearchNote",
            "QuestionRecord",
            "UncertaintyRecord",
            "DossierSnapshot",
            "EditorialState",
            "EditorialDecision",
            "ResearchRequest",
            "StoryPlan",
            "ScriptRevision",
            "ScriptChangeSet",
            "ListenerState",
            "ClaimSet",
            "VerificationReport",
            "EditorialReview",
            "CalculationRecord",
            "ShowNotes",
            "ShowNotesReview",
            "VoiceProfile",
            "PronunciationLexicon",
            "PerformancePlan",
            "AudioSegment",
            "AudioMaster",
            "Transcript",
            "AudioQAReport",
            "ReleaseManifest",
            "EvaluationCase",
            "EvaluationResult",
            "EvaluationAnnotation",
            "HumanAssessment",
            "DiagnosticArtifact"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "revision_id",
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AudioSelector": {
      "additionalProperties": false,
      "properties": {
        "audio_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        }
      },
      "required": [
        "audio_ref",
        "start_frame",
        "end_frame"
      ],
      "title": "AudioSelector",
      "type": "object"
    },
    "ConsideredOption": {
      "additionalProperties": false,
      "properties": {
        "option": {
          "minLength": 1,
          "title": "Option",
          "type": "string"
        },
        "benefit": {
          "title": "Benefit",
          "type": "string"
        },
        "unresolved_problem": {
          "title": "Unresolved Problem",
          "type": "string"
        },
        "basis_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Basis Refs",
          "type": "array"
        }
      },
      "required": [
        "option",
        "benefit",
        "unresolved_problem",
        "basis_refs"
      ],
      "title": "ConsideredOption",
      "type": "object"
    },
    "DependencyDisposition": {
      "additionalProperties": false,
      "properties": {
        "prior_input_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "current_input_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Current Input Refs",
          "type": "array"
        },
        "disposition": {
          "enum": [
            "retained",
            "replaced",
            "removed",
            "lineage_only"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "subject_selectors": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/WholeArtifactSelector"
              },
              {
                "$ref": "#/$defs/ScriptSelector"
              },
              {
                "$ref": "#/$defs/NoteSelector"
              },
              {
                "$ref": "#/$defs/ShowNotesSelector"
              },
              {
                "$ref": "#/$defs/AudioSelector"
              }
            ]
          },
          "title": "Subject Selectors",
          "type": "array"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "prior_input_ref",
        "current_input_refs",
        "disposition",
        "subject_selectors",
        "basis"
      ],
      "title": "DependencyDisposition",
      "type": "object"
    },
    "LocalScriptSelector": {
      "additionalProperties": false,
      "properties": {
        "act_id": {
          "format": "uuid",
          "title": "Act Id",
          "type": "string"
        },
        "block_id": {
          "format": "uuid",
          "title": "Block Id",
          "type": "string"
        },
        "item_id": {
          "format": "uuid",
          "title": "Item Id",
          "type": "string"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Char End"
        }
      },
      "required": [
        "act_id",
        "block_id",
        "item_id",
        "char_start",
        "char_end"
      ],
      "title": "LocalScriptSelector",
      "type": "object"
    },
    "NoteSelector": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "const": "answer_markdown",
          "title": "Field",
          "type": "string"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "char_end": {
          "minimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "note_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "field",
        "char_start",
        "char_end",
        "note_ref"
      ],
      "title": "NoteSelector",
      "type": "object"
    },
    "RequestDisposition": {
      "additionalProperties": false,
      "properties": {
        "request_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "action": {
          "enum": [
            "still_open",
            "addressed",
            "obsolete"
          ],
          "title": "Action",
          "type": "string"
        },
        "current_subject_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "current_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/WholeArtifactSelector"
            },
            {
              "$ref": "#/$defs/ScriptSelector"
            },
            {
              "$ref": "#/$defs/NoteSelector"
            },
            {
              "$ref": "#/$defs/ShowNotesSelector"
            },
            {
              "$ref": "#/$defs/AudioSelector"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Location"
        },
        "basis_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Basis Refs",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "request_ref",
        "action",
        "current_subject_ref",
        "current_location",
        "basis_refs",
        "reason"
      ],
      "title": "RequestDisposition",
      "type": "object"
    },
    "ScriptSelector": {
      "additionalProperties": false,
      "properties": {
        "script_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "selector": {
          "$ref": "#/$defs/LocalScriptSelector"
        }
      },
      "required": [
        "script_ref",
        "selector"
      ],
      "title": "ScriptSelector",
      "type": "object"
    },
    "ShowNotesSelector": {
      "additionalProperties": false,
      "properties": {
        "show_notes_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "field": {
          "enum": [
            "title",
            "description",
            "chapter_title",
            "chapter_summary",
            "citation_metadata",
            "disclosure",
            "uncertainty_note"
          ],
          "title": "Field",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Item Id"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "char_end": {
          "minimum": 0,
          "title": "Char End",
          "type": "integer"
        }
      },
      "required": [
        "show_notes_ref",
        "field",
        "item_id",
        "char_start",
        "char_end"
      ],
      "title": "ShowNotesSelector",
      "type": "object"
    },
    "SubjectDispositions": {
      "additionalProperties": false,
      "properties": {
        "subject_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "dispositions": {
          "items": {
            "$ref": "#/$defs/DependencyDisposition"
          },
          "title": "Dispositions",
          "type": "array"
        }
      },
      "required": [
        "subject_ref",
        "dispositions"
      ],
      "title": "SubjectDispositions",
      "type": "object"
    },
    "WholeArtifactSelector": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "whole": {
          "const": true,
          "title": "Whole",
          "type": "boolean"
        }
      },
      "required": [
        "artifact_ref",
        "whole"
      ],
      "title": "WholeArtifactSelector",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "state_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "action": {
      "enum": [
        "commission",
        "integrate",
        "change_direction",
        "proceed",
        "revise",
        "narrow_scope",
        "stop"
      ],
      "title": "Action",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "considered_options": {
      "items": {
        "$ref": "#/$defs/ConsideredOption"
      },
      "title": "Considered Options",
      "type": "array"
    },
    "selected_option": {
      "minLength": 1,
      "title": "Selected Option",
      "type": "string"
    },
    "input_result_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Input Result Ids",
      "type": "array"
    },
    "question_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Question Refs",
      "type": "array"
    },
    "reviewed_output_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Reviewed Output Refs",
      "type": "array"
    },
    "dependency_dispositions": {
      "items": {
        "$ref": "#/$defs/SubjectDispositions"
      },
      "title": "Dependency Dispositions",
      "type": "array"
    },
    "request_dispositions": {
      "items": {
        "$ref": "#/$defs/RequestDisposition"
      },
      "title": "Request Dispositions",
      "type": "array"
    },
    "expected_effect": {
      "minLength": 1,
      "title": "Expected Effect",
      "type": "string"
    },
    "remaining_risks": {
      "items": {
        "type": "string"
      },
      "title": "Remaining Risks",
      "type": "array"
    }
  },
  "required": [
    "state_ref",
    "action",
    "reason",
    "considered_options",
    "selected_option",
    "input_result_ids",
    "question_refs",
    "reviewed_output_refs",
    "dependency_dispositions",
    "request_dispositions",
    "expected_effect",
    "remaining_risks"
  ],
  "title": "EditorialDecision",
  "type": "object",
  "$id": "urn:podgen:EditorialDecision:1.0"
}
