{
  "$defs": {
    "BlobRef": {
      "additionalProperties": false,
      "properties": {
        "storage_key": {
          "minLength": 1,
          "title": "Storage Key",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "storage_key",
        "sha256",
        "byte_length",
        "media_type"
      ],
      "title": "BlobRef",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "blob_ref": {
      "$ref": "#/$defs/BlobRef"
    },
    "media_metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Media Metadata",
      "type": "object"
    },
    "allowed_roles": {
      "items": {
        "enum": [
          "director",
          "evaluator"
        ],
        "type": "string"
      },
      "title": "Allowed Roles",
      "type": "array"
    }
  },
  "required": [
    "blob_ref",
    "media_metadata",
    "allowed_roles"
  ],
  "title": "PublishedAsset",
  "type": "object"
}
