{
  "$defs": {
    "ActPlan": {
      "additionalProperties": false,
      "properties": {
        "plan_act_id": {
          "format": "uuid",
          "title": "Plan Act Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "listener_question": {
          "minLength": 1,
          "title": "Listener Question",
          "type": "string"
        },
        "intended_change_in_understanding": {
          "minLength": 1,
          "title": "Intended Change In Understanding",
          "type": "string"
        },
        "prerequisite_concepts": {
          "items": {
            "type": "string"
          },
          "title": "Prerequisite Concepts",
          "type": "array"
        },
        "material_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Material Refs",
          "type": "array"
        },
        "limitations_to_voice": {
          "items": {
            "type": "string"
          },
          "title": "Limitations To Voice",
          "type": "array"
        },
        "transitions": {
          "$ref": "#/$defs/Transitions"
        },
        "promises_opened": {
          "items": {
            "type": "string"
          },
          "title": "Promises Opened",
          "type": "array"
        },
        "promises_addressed": {
          "items": {
            "type": "string"
          },
          "title": "Promises Addressed",
          "type": "array"
        },
        "estimated_seconds_range": {
          "$ref": "#/$defs/SecondsRange"
        },
        "priority": {
          "enum": [
            "essential",
            "optional"
          ],
          "title": "Priority",
          "type": "string"
        }
      },
      "required": [
        "plan_act_id",
        "title",
        "listener_question",
        "intended_change_in_understanding",
        "prerequisite_concepts",
        "material_refs",
        "transitions",
        "promises_opened",
        "promises_addressed",
        "estimated_seconds_range",
        "priority"
      ],
      "title": "ActPlan",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "EpisodeSpec",
            "PolicyBundle",
            "Policy",
            "PromptDefinition",
            "ToolsetDefinition",
            "ModelProfile",
            "CapabilityReport",
            "ProcessingProfile",
            "SourceRevision",
            "SourceRepresentation",
            "EvidenceSpan",
            "SourceRelation",
            "SourceFamilyAssessment",
            "DerivedPreview",
            "ResearchNote",
            "QuestionRecord",
            "UncertaintyRecord",
            "DossierSnapshot",
            "EditorialState",
            "EditorialDecision",
            "ResearchRequest",
            "StoryPlan",
            "ScriptRevision",
            "ScriptChangeSet",
            "ListenerState",
            "ClaimSet",
            "VerificationReport",
            "EditorialReview",
            "CalculationRecord",
            "ShowNotes",
            "ShowNotesReview",
            "VoiceProfile",
            "PronunciationLexicon",
            "PerformancePlan",
            "AudioSegment",
            "AudioMaster",
            "Transcript",
            "AudioQAReport",
            "ReleaseManifest",
            "EvaluationCase",
            "EvaluationResult",
            "EvaluationAnnotation",
            "HumanAssessment",
            "DiagnosticArtifact"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "revision_id",
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "DurationStrategy": {
      "additionalProperties": false,
      "properties": {
        "estimated_seconds_range": {
          "$ref": "#/$defs/SecondsRange"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "optional_material": {
          "items": {
            "type": "string"
          },
          "title": "Optional Material",
          "type": "array"
        }
      },
      "required": [
        "estimated_seconds_range",
        "assumptions",
        "optional_material"
      ],
      "title": "DurationStrategy",
      "type": "object"
    },
    "Ending": {
      "additionalProperties": false,
      "properties": {
        "answer_to_deliver": {
          "minLength": 1,
          "title": "Answer To Deliver",
          "type": "string"
