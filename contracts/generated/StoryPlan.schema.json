      "title": "Ending",
      "type": "object"
    },
    "HostFunction": {
      "additionalProperties": false,
      "properties": {
        "speaker_id": {
          "format": "uuid",
          "title": "Speaker Id",
          "type": "string"
        },
        "contribution": {
          "minLength": 1,
          "title": "Contribution",
          "type": "string"
        },
        "interaction_guidance": {
          "minLength": 1,
          "title": "Interaction Guidance",
          "type": "string"
        },
        "speech_register": {
          "minLength": 1,
          "title": "Speech Register",
          "type": "string"
        }
      },
      "required": [
        "speaker_id",
        "contribution",
        "interaction_guidance",
        "speech_register"
      ],
      "title": "HostFunction",
      "type": "object"
    },
    "Opening": {
      "additionalProperties": false,
      "properties": {
        "approach": {
          "minLength": 1,
          "title": "Approach",
          "type": "string"
        },
        "material_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Material Refs",
          "type": "array"
        },
        "question_to_open": {
          "minLength": 1,
          "title": "Question To Open",
          "type": "string"
        }
      },
      "required": [
        "approach",
        "material_refs",
        "question_to_open"
      ],
      "title": "Opening",
      "type": "object"
    },
    "SecondsRange": {
      "additionalProperties": false,
      "properties": {
        "min_seconds": {
          "minimum": 0,
          "title": "Min Seconds",
          "type": "integer"
        },
        "max_seconds": {
          "minimum": 0,
          "title": "Max Seconds",
          "type": "integer"
        }
      },
      "required": [
        "min_seconds",
        "max_seconds"
      ],
      "title": "SecondsRange",
      "type": "object"
    },
    "StoryOption": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "format": "uuid",
          "title": "Option Id",
          "type": "string"
        },
        "angle": {
          "minLength": 1,
          "title": "Angle",
          "type": "string"
        },
        "route_summary": {
          "minLength": 1,
          "title": "Route Summary",
          "type": "string"
        },
        "strongest_material_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Strongest Material Refs",
          "type": "array"
        },
        "listener_benefit": {
          "minLength": 1,
          "title": "Listener Benefit",
          "type": "string"
        },
        "weakness": {
          "title": "Weakness",
          "type": "string"
        },
        "research_needed": {
          "items": {
            "type": "string"
          },
          "title": "Research Needed",
          "type": "array"
        },
        "selection_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selection Reason"
        }
      },
      "required": [
        "option_id",
        "angle",
        "route_summary",
        "strongest_material_refs",
        "listener_benefit",
        "weakness",
        "research_needed",
        "selection_reason"
      ],
      "title": "StoryOption",
      "type": "object"
    },
    "Transitions": {
      "additionalProperties": false,
      "properties": {
        "from_previous": {
          "title": "From Previous",
          "type": "string"
        },
        "toward_next": {
          "title": "Toward Next",
          "type": "string"
        }
      },
      "required": [
        "from_previous",
        "toward_next"
      ],
      "title": "Transitions",
      "type": "object"
    }
