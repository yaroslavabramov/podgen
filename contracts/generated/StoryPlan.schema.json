  "additionalProperties": false,
  "properties": {
    "episode_spec_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "dossier_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "editorial_decision_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "main_question": {
      "minLength": 1,
      "title": "Main Question",
      "type": "string"
    },
    "listener_promise": {
      "minLength": 1,
      "title": "Listener Promise",
      "type": "string"
    },
    "working_answer": {
      "minLength": 1,
      "title": "Working Answer",
      "type": "string"
    },
    "selected_option_id": {
      "format": "uuid",
      "title": "Selected Option Id",
      "type": "string"
    },
    "considered_options": {
      "items": {
        "$ref": "#/$defs/StoryOption"
      },
      "title": "Considered Options",
      "type": "array"
    },
    "opening": {
      "$ref": "#/$defs/Opening"
    },
    "acts": {
      "items": {
        "$ref": "#/$defs/ActPlan"
      },
      "title": "Acts",
      "type": "array"
    },
    "ending": {
      "$ref": "#/$defs/Ending"
    },
    "host_functions": {
      "items": {
        "$ref": "#/$defs/HostFunction"
      },
      "title": "Host Functions",
      "type": "array"
    },
    "duration_strategy": {
      "$ref": "#/$defs/DurationStrategy"
    },
    "unresolved_research_request_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Unresolved Research Request Refs",
      "type": "array"
    }
  },
  "required": [
    "episode_spec_ref",
    "dossier_ref",
    "editorial_decision_ref",
    "main_question",
    "listener_promise",
    "working_answer",
    "selected_option_id",
    "considered_options",
    "opening",
    "acts",
    "ending",
    "host_functions",
    "duration_strategy",
    "unresolved_research_request_refs"
  ],
  "title": "StoryPlan",
  "type": "object",
  "$id": "urn:podgen:StoryPlan:1.0"
}
