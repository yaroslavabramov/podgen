          "items": {
            "type": "string"
          },
          "title": "Qualifications",
          "type": "array"
        },
        "promises_to_close": {
          "items": {
            "type": "string"
          },
          "title": "Promises To Close",
          "type": "array"
        }
      },
      "required": [
        "answer_to_deliver",
        "promises_to_close"
