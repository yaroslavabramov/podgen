{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "EpisodeSpec",
            "PolicyBundle",
            "Policy",
            "PromptDefinition",
            "ToolsetDefinition",
            "ModelProfile",
            "CapabilityReport",
            "ProcessingProfile",
            "SourceRevision",
            "SourceRepresentation",
            "EvidenceSpan",
            "SourceRelation",
            "SourceFamilyAssessment",
            "DerivedPreview",
            "ResearchNote",
            "QuestionRecord",
            "UncertaintyRecord",
            "DossierSnapshot",
            "EditorialState",
            "EditorialDecision",
            "ResearchRequest",
            "StoryPlan",
            "ScriptRevision",
            "ScriptChangeSet",
            "ListenerState",
            "ClaimSet",
            "VerificationReport",
            "EditorialReview",
            "CalculationRecord",
            "ShowNotes",
            "ShowNotesReview",
            "VoiceProfile",
            "PronunciationLexicon",
            "PerformancePlan",
            "AudioSegment",
            "AudioMaster",
            "Transcript",
            "AudioQAReport",
            "ReleaseManifest",
            "EvaluationCase",
            "EvaluationResult",
            "EvaluationAnnotation",
            "HumanAssessment",
            "DiagnosticArtifact"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "revision_id",
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AudioCoverage": {
      "additionalProperties": false,
      "properties": {
        "expected_ranges": {
          "items": {
            "$ref": "#/$defs/FrameRange"
          },
          "title": "Expected Ranges",
          "type": "array"
        },
        "processed_ranges": {
          "items": {
            "$ref": "#/$defs/FrameRange"
          },
          "title": "Processed Ranges",
          "type": "array"
        },
        "uncovered_ranges": {
          "items": {
            "$ref": "#/$defs/FrameRange"
          },
          "title": "Uncovered Ranges",
          "type": "array"
        },
        "exclusions": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Exclusions",
          "type": "array"
        }
      },
      "required": [
        "expected_ranges",
        "processed_ranges",
        "uncovered_ranges",
        "exclusions"
      ],
      "title": "AudioCoverage",
      "type": "object"
    },
    "AudioFinding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "format": "uuid",
          "title": "Finding Id",
          "type": "string"
        },
        "category": {
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "major",
            "minor",
            "advisory"
          ],
          "title": "Severity",
          "type": "string"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "policy_rule_id": {
          "minLength": 1,
          "title": "Policy Rule Id",
          "type": "string"
        },
        "sample_ranges": {
          "items": {
            "$ref": "#/$defs/FrameRange"
          },
          "title": "Sample Ranges",
          "type": "array"
        },
        "script_selectors": {
          "items": {
            "$ref": "#/$defs/ScriptSelector"
          },
          "title": "Script Selectors",
          "type": "array"
        },
        "observation": {
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        },
        "expected": {
          "minLength": 1,
          "title": "Expected",
          "type": "string"
        },
        "basis_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Basis Refs",
          "type": "array"
        },
        "resolution": {
          "enum": [
            "open",
            "confirmed",
            "dismissed"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "recommended_action": {
          "minLength": 1,
          "title": "Recommended Action",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "category",
        "severity",
        "blocking",
        "policy_rule_id",
        "sample_ranges",
        "script_selectors",
        "observation",
        "expected",
        "basis_refs",
        "resolution",
        "rationale",
        "recommended_action"
      ],
      "title": "AudioFinding",
      "type": "object"
    },
    "AudioSelector": {
      "additionalProperties": false,
      "properties": {
        "audio_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        }
      },
      "required": [
        "audio_ref",
        "start_frame",
        "end_frame"
      ],
      "title": "AudioSelector",
      "type": "object"
    },
    "BlobRef": {
      "additionalProperties": false,
      "properties": {
        "storage_key": {
          "minLength": 1,
          "title": "Storage Key",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "storage_key",
        "sha256",
        "byte_length",
        "media_type"
      ],
      "title": "BlobRef",
      "type": "object"
    },
    "DependencyDisposition": {
      "additionalProperties": false,
      "properties": {
        "prior_input_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "current_input_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Current Input Refs",
          "type": "array"
        },
        "disposition": {
          "enum": [
            "retained",
            "replaced",
            "removed",
            "lineage_only"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "subject_selectors": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/WholeArtifactSelector"
              },
              {
                "$ref": "#/$defs/ScriptSelector"
              },
              {
                "$ref": "#/$defs/NoteSelector"
              },
              {
                "$ref": "#/$defs/ShowNotesSelector"
              },
              {
                "$ref": "#/$defs/AudioSelector"
              }
            ]
          },
          "title": "Subject Selectors",
          "type": "array"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "prior_input_ref",
        "current_input_refs",
        "disposition",
        "subject_selectors",
        "basis"
      ],
      "title": "DependencyDisposition",
      "type": "object"
    },
    "FrameRange": {
      "additionalProperties": false,
      "properties": {
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        }
      },
      "required": [
        "start_frame",
        "end_frame"
      ],
      "title": "FrameRange",
      "type": "object"
    },
    "JsonValue": {},
    "ListeningPass": {
      "additionalProperties": false,
      "properties": {
        "invocation_id": {
          "format": "uuid",
          "title": "Invocation Id",
          "type": "string"
        },
        "model_profile_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "audio_ranges": {
          "items": {
            "$ref": "#/$defs/FrameRange"
          },
          "title": "Audio Ranges",
          "type": "array"
        },
        "assessment_blob": {
          "$ref": "#/$defs/BlobRef"
        }
      },
      "required": [
        "invocation_id",
        "model_profile_ref",
        "audio_ranges",
        "assessment_blob"
      ],
      "title": "ListeningPass",
      "type": "object"
    },
    "LocalScriptSelector": {
      "additionalProperties": false,
      "properties": {
        "act_id": {
          "format": "uuid",
          "title": "Act Id",
          "type": "string"
        },
        "block_id": {
          "format": "uuid",
          "title": "Block Id",
          "type": "string"
        },
        "item_id": {
          "format": "uuid",
          "title": "Item Id",
          "type": "string"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Char End"
        }
      },
      "required": [
        "act_id",
        "block_id",
        "item_id",
        "char_start",
        "char_end"
      ],
      "title": "LocalScriptSelector",
      "type": "object"
    },
    "MeasurementRecord": {
      "additionalProperties": false,
      "properties": {
        "subject_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "processing_profile_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "measurement_blob": {
          "$ref": "#/$defs/BlobRef"
        }
      },
      "required": [
        "subject_ref",
        "processing_profile_ref",
        "measurement_blob"
      ],
      "title": "MeasurementRecord",
      "type": "object"
    },
    "NoteSelector": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "const": "answer_markdown",
          "title": "Field",
          "type": "string"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "char_end": {
          "minimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "note_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "field",
        "char_start",
        "char_end",
        "note_ref"
      ],
      "title": "NoteSelector",
      "type": "object"
    },
    "ScriptSelector": {
      "additionalProperties": false,
      "properties": {
        "script_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "selector": {
          "$ref": "#/$defs/LocalScriptSelector"
        }
      },
      "required": [
        "script_ref",
        "selector"
      ],
      "title": "ScriptSelector",
      "type": "object"
    },
    "ShowNotesSelector": {
      "additionalProperties": false,
      "properties": {
        "show_notes_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "field": {
          "enum": [
            "title",
            "description",
            "chapter_title",
            "chapter_summary",
            "citation_metadata",
            "disclosure",
            "uncertainty_note"
          ],
          "title": "Field",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Item Id"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "char_end": {
          "minimum": 0,
          "title": "Char End",
          "type": "integer"
        }
      },
      "required": [
        "show_notes_ref",
        "field",
        "item_id",
        "char_start",
        "char_end"
      ],
      "title": "ShowNotesSelector",
      "type": "object"
    },
    "WholeArtifactSelector": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "whole": {
          "const": true,
          "title": "Whole",
          "type": "boolean"
        }
      },
      "required": [
        "artifact_ref",
        "whole"
      ],
      "title": "WholeArtifactSelector",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scope": {
      "enum": [
        "segment",
        "master"
      ],
      "title": "Scope",
      "type": "string"
    },
    "script_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "performance_plan_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "transcript_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "audio_segment_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "audio_master_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "measurement_records": {
      "items": {
        "$ref": "#/$defs/MeasurementRecord"
      },
      "title": "Measurement Records",
      "type": "array"
    },
    "listening_passes": {
      "items": {
        "$ref": "#/$defs/ListeningPass"
      },
      "title": "Listening Passes",
      "type": "array"
    },
    "coverage_report": {
      "$ref": "#/$defs/AudioCoverage"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/AudioFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "dependency_dispositions": {
      "items": {
        "$ref": "#/$defs/DependencyDisposition"
      },
      "title": "Dependency Dispositions",
      "type": "array"
    },
    "result": {
      "enum": [
        "acceptable",
        "changes_required",
        "inconclusive"
      ],
      "title": "Result",
      "type": "string"
    }
  },
  "required": [
    "scope",
    "script_ref",
    "performance_plan_ref",
    "transcript_ref",
    "audio_segment_ref",
    "audio_master_ref",
    "policy_ref",
    "measurement_records",
    "listening_passes",
    "coverage_report",
    "findings",
    "dependency_dispositions",
    "result"
  ],
  "title": "AudioQAReport",
  "type": "object",
  "$id": "urn:podgen:AudioQAReport:1.0"
}
