{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "EpisodeSpec",
            "PolicyBundle",
            "Policy",
            "PromptDefinition",
            "ToolsetDefinition",
            "ModelProfile",
            "CapabilityReport",
            "ProcessingProfile",
            "SourceRevision",
            "SourceRepresentation",
            "EvidenceSpan",
            "SourceRelation",
            "SourceFamilyAssessment",
            "DerivedPreview",
            "ResearchNote",
            "QuestionRecord",
            "UncertaintyRecord",
            "DossierSnapshot",
            "EditorialState",
            "EditorialDecision",
            "ResearchRequest",
            "StoryPlan",
            "ScriptRevision",
            "ScriptChangeSet",
            "ListenerState",
            "ClaimSet",
            "VerificationReport",
            "EditorialReview",
            "CalculationRecord",
            "ShowNotes",
            "ShowNotesReview",
            "VoiceProfile",
            "PronunciationLexicon",
            "PerformancePlan",
            "AudioSegment",
            "AudioMaster",
            "Transcript",
            "AudioQAReport",
            "ReleaseManifest",
            "EvaluationCase",
            "EvaluationResult",
            "EvaluationAnnotation",
            "HumanAssessment",
            "DiagnosticArtifact"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "revision_id",
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "mode": {
      "enum": [
        "open_web",
        "supplied_only"
      ],
      "title": "Mode",
      "type": "string"
    },
    "source_policy_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "authorized_input_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Authorized Input Ids",
      "type": "array"
    },
    "authorized_source_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Authorized Source Refs",
      "type": "array"
    },
    "network_rule_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Network Rule Id"
    },
    "external_processing_rule_id": {
      "minLength": 1,
      "title": "External Processing Rule Id",
      "type": "string"
    }
  },
  "required": [
    "mode",
    "source_policy_ref",
    "authorized_input_ids",
    "authorized_source_refs",
    "network_rule_id",
    "external_processing_rule_id"
  ],
  "title": "SourceScope",
  "type": "object"
}
