{
  "$defs": {
    "RecognitionPrice": {
      "additionalProperties": false,
      "properties": {
        "usd_per_audio_minute": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Usd Per Audio Minute",
          "type": "string"
        },
        "source_url": {
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "checked_at": {
          "minLength": 1,
          "title": "Checked At",
          "type": "string"
        }
      },
      "required": [
        "usd_per_audio_minute",
        "source_url",
        "checked_at"
      ],
      "title": "RecognitionPrice",
      "type": "object"
    },
    "RecognitionProfile": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "fish",
          "default": "fish",
          "title": "Provider",
          "type": "string"
        },
        "model_id": {
          "const": "transcribe-1-pro",
          "default": "transcribe-1-pro",
          "title": "Model Id",
          "type": "string"
        },
        "language": {
          "const": "ru",
          "default": "ru",
          "title": "Language",
          "type": "string"
        },
        "ignore_timestamps": {
          "const": false,
          "default": false,
          "title": "Ignore Timestamps",
          "type": "boolean"
        },
        "diarize": {
          "const": false,
          "default": false,
          "title": "Diarize",
          "type": "boolean"
        },
        "tag_audio_events": {
          "const": false,
          "default": false,
          "title": "Tag Audio Events",
          "type": "boolean"
        },
        "request_timeout_seconds": {
          "default": 900,
          "maximum": 1800,
          "minimum": 1,
          "title": "Request Timeout Seconds",
          "type": "number"
        }
      },
      "title": "RecognitionProfile",
      "type": "object"
    },
    "RuntimeRef": {
      "additionalProperties": false,
      "properties": {
        "record_kind": {
          "enum": [
            "search_record",
            "tool_execution",
            "context_assembly",
            "user_input",
            "acquisition_record",
            "evaluation_reading"
          ],
          "title": "Record Kind",
          "type": "string"
        },
        "record_id": {
          "format": "uuid",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "RuntimeRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "audio-fidelity-evaluation/1",
      "default": "audio-fidelity-evaluation/1",
      "title": "Contract",
      "type": "string"
    },
    "audit_id": {
      "format": "uuid",
      "title": "Audit Id",
      "type": "string"
    },
    "comparison_run_id": {
      "format": "uuid",
      "title": "Comparison Run Id",
      "type": "string"
    },
    "result_ref": {
      "$ref": "#/$defs/RuntimeRef"
    },
    "recognition": {
      "$ref": "#/$defs/RecognitionProfile"
    },
    "credential_env": {
      "default": "FISH_API_KEY",
      "minLength": 1,
      "title": "Credential Env",
      "type": "string"
    },
    "price": {
      "$ref": "#/$defs/RecognitionPrice"
    },
    "max_requests": {
      "const": 1,
      "default": 1,
      "title": "Max Requests",
      "type": "integer"
    },
    "max_cost_usd": {
      "default": "0.25",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "Max Cost Usd",
      "type": "string"
    },
    "reservation_usd": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "Reservation Usd",
      "type": "string"
    },
    "clip_margin_seconds": {
      "default": 1.5,
      "maximum": 10,
      "minimum": 0,
      "title": "Clip Margin Seconds",
      "type": "number"
    },
    "max_review_clip_seconds": {
      "default": 45,
      "maximum": 45,
      "minimum": 1,
      "title": "Max Review Clip Seconds",
      "type": "number"
    }
  },
  "required": [
    "audit_id",
    "comparison_run_id",
    "result_ref",
    "price",
    "reservation_usd"
  ],
  "title": "FidelityConfig",
  "type": "object"
}
