{
  "$defs": {
    "AudioSubject": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "comparison_result",
            "assembly"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/RuntimeRef"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "AudioSubject",
      "type": "object"
    },
    "RuntimeRef": {
      "additionalProperties": false,
      "properties": {
        "record_kind": {
          "enum": [
            "search_record",
            "tool_execution",
            "context_assembly",
            "user_input",
            "acquisition_record",
            "evaluation_reading"
          ],
          "title": "Record Kind",
          "type": "string"
        },
        "record_id": {
          "format": "uuid",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "RuntimeRef",
      "type": "object"
    },
    "SynthesisPart": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "comparison_result",
            "repair_part"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/RuntimeRef"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "SynthesisPart",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "audio-confirmed-fragment-repair/1",
      "default": "audio-confirmed-fragment-repair/1",
      "title": "Contract",
      "type": "string"
    },
    "repair_id": {
      "format": "uuid",
      "title": "Repair Id",
      "type": "string"
    },
    "comparison_run_id": {
      "format": "uuid",
      "title": "Comparison Run Id",
      "type": "string"
    },
    "parent_subject": {
      "$ref": "#/$defs/AudioSubject"
    },
    "part_source": {
      "$ref": "#/$defs/SynthesisPart"
    },
    "review_id": {
      "format": "uuid",
      "title": "Review Id",
      "type": "string"
    },
    "review_result_ref": {
      "$ref": "#/$defs/RuntimeRef"
    },
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "reservation_per_request_usd": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "Reservation Per Request Usd",
      "type": "string"
    },
    "max_cost_usd": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "Max Cost Usd",
      "type": "string"
    },
    "max_requests": {
      "default": 1,
      "maximum": 3,
      "minimum": 1,
      "title": "Max Requests",
      "type": "integer"
    },
    "request_timeout_seconds": {
      "default": 900,
      "maximum": 1800,
      "minimum": 1,
      "title": "Request Timeout Seconds",
      "type": "number"
    },
    "max_quality_depth": {
      "default": 3,
      "maximum": 3,
      "minimum": 1,
      "title": "Max Quality Depth",
      "type": "integer"
    }
  },
  "required": [
    "repair_id",
    "comparison_run_id",
    "parent_subject",
    "part_source",
    "review_id",
    "review_result_ref",
    "candidate_id",
    "reason",
    "reservation_per_request_usd",
    "max_cost_usd"
  ],
  "title": "RepairConfig",
  "type": "object"
}
