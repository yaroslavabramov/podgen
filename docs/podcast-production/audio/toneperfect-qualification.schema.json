{
  "$defs": {
    "Case": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "audio_path": {
          "format": "path",
          "title": "Audio Path",
          "type": "string"
        },
        "audio_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Audio Sha256",
          "type": "string"
        },
        "reference_text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reference Text",
          "type": "string"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Provenance",
          "type": "object"
        },
        "evaluation": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Evaluation",
          "type": "object"
        }
      },
      "required": [
        "case_id",
        "audio_path",
        "audio_sha256",
        "reference_text",
        "provenance",
        "evaluation"
      ],
      "title": "Case",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "toneperfect-qualification/1",
      "default": "toneperfect-qualification/1",
      "title": "Contract",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "max_credits": {
      "default": 10,
      "maximum": 10,
      "minimum": 1,
      "title": "Max Credits",
      "type": "integer"
    },
    "credential_env": {
      "default": "TONEPERFECT_API_KEY",
      "minLength": 1,
      "title": "Credential Env",
      "type": "string"
    },
    "timeout_seconds": {
      "default": 100,
      "maximum": 180,
      "minimum": 27,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "max_attempts_per_case": {
      "default": 3,
      "maximum": 3,
      "minimum": 1,
      "title": "Max Attempts Per Case",
      "type": "integer"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/Case"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "cases"
  ],
  "title": "Trial",
  "type": "object"
}
