{
  "$defs": {
    "ReviewerPrice": {
      "additionalProperties": false,
      "properties": {
        "usd_per_million_input_tokens": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Usd Per Million Input Tokens",
          "type": "string"
        },
        "usd_per_million_output_tokens": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Usd Per Million Output Tokens",
          "type": "string"
        },
        "source_url": {
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "checked_at": {
          "minLength": 1,
          "title": "Checked At",
          "type": "string"
        }
      },
      "required": [
        "usd_per_million_input_tokens",
        "usd_per_million_output_tokens",
        "source_url",
        "checked_at"
      ],
      "title": "ReviewerPrice",
      "type": "object"
    },
    "ReviewerProfile": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "const": "gemini-3.8-flash",
          "default": "gemini-3.8-flash",
          "title": "Model Id",
          "type": "string"
        },
        "max_output_tokens": {
          "default": 8192,
          "maximum": 32768,
          "minimum": 8192,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "thinking_level": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Thinking Level",
          "type": "string"
        },
        "request_timeout_seconds": {
          "default": 180,
          "maximum": 1800,
          "minimum": 1,
          "title": "Request Timeout Seconds",
          "type": "number"
        }
      },
      "title": "ReviewerProfile",
      "type": "object"
    },
    "RuntimeRef": {
      "additionalProperties": false,
      "properties": {
        "record_kind": {
          "enum": [
            "search_record",
            "tool_execution",
            "context_assembly",
            "user_input",
            "acquisition_record",
            "evaluation_reading"
          ],
          "title": "Record Kind",
          "type": "string"
        },
        "record_id": {
          "format": "uuid",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "RuntimeRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "audio-fidelity-adjudication/1",
      "default": "audio-fidelity-adjudication/1",
      "title": "Contract",
      "type": "string"
    },
    "review_id": {
      "format": "uuid",
      "title": "Review Id",
      "type": "string"
    },
    "comparison_run_id": {
      "format": "uuid",
      "title": "Comparison Run Id",
      "type": "string"
    },
    "fidelity_audit_id": {
      "format": "uuid",
      "title": "Fidelity Audit Id",
      "type": "string"
    },
    "candidate_result_ref": {
      "$ref": "#/$defs/RuntimeRef"
    },
    "reviewer": {
      "$ref": "#/$defs/ReviewerProfile"
    },
    "output_language": {
      "const": "ru",
      "default": "ru",
      "title": "Output Language",
      "type": "string"
    },
    "credential_env": {
      "default": "JEMINI_API_KEY",
      "minLength": 1,
      "title": "Credential Env",
      "type": "string"
    },
    "prompt_path": {
      "minLength": 1,
      "title": "Prompt Path",
      "type": "string"
    },
    "prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "price": {
      "$ref": "#/$defs/ReviewerPrice"
    },
    "reservation_per_request_usd": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "Reservation Per Request Usd",
      "type": "string"
    },
    "max_cost_usd": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "Max Cost Usd",
      "type": "string"
    },
    "max_requests": {
      "default": 32,
      "maximum": 64,
      "minimum": 1,
      "title": "Max Requests",
      "type": "integer"
    },
    "max_window_seconds": {
      "default": 45,
      "maximum": 45,
      "minimum": 1,
      "title": "Max Window Seconds",
      "type": "number"
    },
    "max_cases_per_window": {
      "default": 8,
      "maximum": 16,
      "minimum": 1,
      "title": "Max Cases Per Window",
      "type": "integer"
    },
    "case_ids": {
      "anyOf": [
        {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Ids"
    }
  },
  "required": [
    "review_id",
    "comparison_run_id",
    "fidelity_audit_id",
    "candidate_result_ref",
    "prompt_path",
    "prompt_sha256",
    "price",
    "reservation_per_request_usd",
    "max_cost_usd"
  ],
  "title": "ReviewConfig",
  "type": "object"
}
