    "PlanningResearchRequest": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "why_needed": {
          "minLength": 1,
          "title": "Why Needed",
          "type": "string"
        },
        "affected_act_ids": {
          "description": "Local act labels; empty for an episode-wide question.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Affected Act Ids",
          "type": "array"
        },
        "material_refs": {
