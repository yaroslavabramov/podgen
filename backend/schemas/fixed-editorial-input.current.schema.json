        {
          "$ref": "#/$defs/PlanningOutputV9"
        },
        {
          "$ref": "#/$defs/PlanningOutput"
        }
      ],
      "title": "Plan"
    }
  },
  "required": [
    "contract",
    "assignment_key",
    "shared_input_digest",
    "document",
    "plan"
  ],
  "title": "FixedEditorialInput",
  "type": "object"
}
