    "ScenePlanningOutput": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ready",
            "needs_research"
          ],
          "title": "Status",
          "type": "string"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScenePlan"
            },
            {
              "type": "null"
