        "question",
        "why_needed",
        "affected_act_ids",
        "material_refs",
        "blocking"
      ],
      "title": "PlanningResearchRequest",
      "type": "object"
    },
    "PlanningSecondsRange": {
      "additionalProperties": false,
      "properties": {
        "min_seconds": {
          "minimum": 0,
          "title": "Min Seconds",
          "type": "integer"
        },
        "max_seconds": {
          "minimum": 0,
          "title": "Max Seconds",
          "type": "integer"
        }
      },
      "required": [
        "min_seconds",
        "max_seconds"
