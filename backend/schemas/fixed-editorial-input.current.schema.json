{
  "$defs": {
    "ActDevelopment": {
      "additionalProperties": false,
      "properties": {
        "development": {
          "description": "What listeners encounter in order: the action, observation, demonstration or thought that changes the situation and carries the story forward. Give enough specific material to write this scene.",
          "minLength": 1,
          "title": "Development",
          "type": "string"
        },
        "material_refs": {
          "description": "Offered material supporting this scene.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Material Refs",
          "type": "array"
        },
        "act_id": {
          "description": "Unique short act label. The names opening and ending are reserved.",
          "minLength": 1,
          "title": "Act Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "estimated_seconds_range": {
          "$ref": "#/$defs/PlanningSecondsRange"
        },
        "priority": {
          "enum": [
            "essential",
            "optional"
          ],
          "title": "Priority",
          "type": "string"
        }
      },
      "required": [
        "development",
        "material_refs",
        "act_id",
        "title",
        "estimated_seconds_range",
        "priority"
      ],
      "title": "ActDevelopment",
      "type": "object"
    },
    "EditorialNote": {
      "additionalProperties": false,
      "properties": {
        "scene": {
          "description": "The exact act_id, opening or ending.",
          "minLength": 1,
          "title": "Scene",
          "type": "string"
        },
        "kind": {
          "enum": [
            "editorial_choice",
            "claim_scope"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "description": "An editorial choice and its reason, or the precise distinction a primary source supports for a particular claim. An internal note for review.",
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "material_refs": {
          "description": "Sources bearing on this note. A claim_scope needs at least one.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Material Refs",
          "type": "array"
        }
      },
      "required": [
        "scene",
        "kind",
        "note",
        "material_refs"
      ],
      "title": "EditorialNote",
      "type": "object"
    },
    "FixedSourceDocument": {
      "additionalProperties": false,
      "properties": {
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "sha256"
      ],
      "title": "FixedSourceDocument",
      "type": "object"
    },
    "PlanProposal": {
      "additionalProperties": false,
      "properties": {
        "main_question": {
          "minLength": 1,
          "title": "Main Question",
          "type": "string"
        },
        "listener_promise": {
          "minLength": 1,
          "title": "Listener Promise",
          "type": "string"
        },
        "working_answer": {
          "description": "Provisional supported answer, including justified uncertainty.",
          "minLength": 1,
          "title": "Working Answer",
          "type": "string"
        },
        "route_summary": {
          "description": "Connected route from initial understanding to the ending.",
          "minLength": 1,
          "title": "Route Summary",
          "type": "string"
        },
        "opening": {
          "$ref": "#/$defs/PlanningOpening"
        },
        "acts": {
          "items": {
            "$ref": "#/$defs/PlanningAct"
          },
          "minItems": 1,
          "title": "Acts",
          "type": "array"
        },
        "ending": {
          "$ref": "#/$defs/PlanningEnding"
        },
        "host_functions": {
          "items": {
            "$ref": "#/$defs/PlanningHostFunction"
          },
          "minItems": 1,
          "title": "Host Functions",
          "type": "array"
        },
        "duration_strategy": {
          "$ref": "#/$defs/PlanningDurationStrategy"
        }
      },
      "required": [
        "main_question",
        "listener_promise",
        "working_answer",
        "route_summary",
        "opening",
        "acts",
        "ending",
        "host_functions",
        "duration_strategy"
      ],
      "title": "PlanProposal",
      "type": "object"
    },
    "PlanProposalV9": {
      "additionalProperties": false,
      "properties": {
        "main_question": {
          "minLength": 1,
          "title": "Main Question",
          "type": "string"
        },
        "listener_promise": {
          "minLength": 1,
          "title": "Listener Promise",
          "type": "string"
        },
        "working_answer": {
          "description": "Provisional supported answer, including justified uncertainty.",
          "minLength": 1,
          "title": "Working Answer",
          "type": "string"
        },
        "route_summary": {
          "description": "Connected route from initial understanding to the ending.",
          "minLength": 1,
          "title": "Route Summary",
          "type": "string"
        },
        "opening": {
          "$ref": "#/$defs/PlanningOpening"
        },
        "acts": {
          "items": {
            "$ref": "#/$defs/PlanningAct"
          },
          "minItems": 1,
          "title": "Acts",
          "type": "array"
        },
        "ending": {
          "$ref": "#/$defs/PlanningFinalMoment"
        },
        "host_functions": {
          "items": {
            "$ref": "#/$defs/PlanningHostFunction"
          },
          "minItems": 1,
          "title": "Host Functions",
          "type": "array"
        },
        "duration_strategy": {
          "$ref": "#/$defs/PlanningDurationStrategy"
        }
      },
      "required": [
        "main_question",
        "listener_promise",
        "working_answer",
        "route_summary",
        "opening",
        "acts",
        "ending",
        "host_functions",
        "duration_strategy"
      ],
      "title": "PlanProposalV9",
      "type": "object"
    },
    "PlanningAct": {
      "additionalProperties": false,
      "properties": {
        "act_id": {
          "description": "Short local label for this act, not a technical UUID.",
          "minLength": 1,
          "title": "Act Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "listener_question": {
          "minLength": 1,
          "title": "Listener Question",
          "type": "string"
        },
        "intended_change_in_understanding": {
          "minLength": 1,
          "title": "Intended Change In Understanding",
          "type": "string"
        },
        "prerequisite_concepts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Prerequisite Concepts",
          "type": "array"
        },
        "material_refs": {
          "description": "Exact supplied locators supporting this act's reasoning.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Material Refs",
          "type": "array"
        },
        "limitations_to_voice": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations To Voice",
          "type": "array"
        },
        "transitions": {
          "$ref": "#/$defs/PlanningTransitions"
        },
        "promises_opened": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Promises Opened",
          "type": "array"
        },
        "promises_addressed": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Promises Addressed",
          "type": "array"
        },
        "estimated_seconds_range": {
          "$ref": "#/$defs/PlanningSecondsRange"
        },
        "priority": {
          "enum": [
            "essential",
            "optional"
          ],
          "title": "Priority",
          "type": "string"
        }
      },
      "required": [
        "act_id",
        "title",
        "listener_question",
        "intended_change_in_understanding",
        "prerequisite_concepts",
        "material_refs",
        "transitions",
        "promises_opened",
        "promises_addressed",
        "estimated_seconds_range",
        "priority"
      ],
      "title": "PlanningAct",
      "type": "object"
    },
    "PlanningChoiceOutput": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ready",
            "needs_research"
          ],
          "title": "Status",
          "type": "string"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanProposalV9"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete selected story, or null when material cannot support one."
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "research_requests": {
          "items": {
            "$ref": "#/$defs/PlanningResearchRequest"
          },
          "title": "Research Requests",
          "type": "array"
        },
        "story_selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/StorySelection"
            },
            {
              "type": "null"
            }
          ],
          "description": "Compare two distinct tellings before developing the selected one in plan. Null is allowed only when no plan is supported."
        }
      },
      "required": [
        "status",
        "plan",
        "research_requests",
        "story_selection"
      ],
      "title": "PlanningChoiceOutput",
      "type": "object"
    },
    "PlanningDurationStrategy": {
      "additionalProperties": false,
      "properties": {
        "estimated_seconds_range": {
          "$ref": "#/$defs/PlanningSecondsRange"
        },
        "assumptions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "optional_material": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Optional Material",
          "type": "array"
        }
      },
      "required": [
        "estimated_seconds_range",
        "assumptions",
        "optional_material"
      ],
      "title": "PlanningDurationStrategy",
      "type": "object"
    },
    "PlanningEnding": {
      "additionalProperties": false,
      "properties": {
        "answer_to_deliver": {
          "minLength": 1,
          "title": "Answer To Deliver",
          "type": "string"
        },
        "qualifications": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Qualifications",
          "type": "array"
        },
        "promises_to_close": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Promises To Close",
          "type": "array"
        }
      },
      "required": [
        "answer_to_deliver",
        "promises_to_close"
      ],
      "title": "PlanningEnding",
      "type": "object"
    },
    "PlanningFinalMoment": {
      "additionalProperties": false,
      "properties": {
        "last_moment": {
          "description": "The chosen last action, observation, discovery or thought the listener encounters; not a recap of the episode's answer or prescribed spoken lines.",
          "minLength": 1,
          "title": "Last Moment",
          "type": "string"
        },
        "why_end_here": {
          "description": "Why this is the stopping point for the chosen story and promise; what remains with the listener without another summary.",
          "minLength": 1,
          "title": "Why End Here",
          "type": "string"
        },
        "promises_to_close": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Promises To Close",
          "type": "array"
        }
      },
      "required": [
        "last_moment",
        "why_end_here",
        "promises_to_close"
      ],
      "title": "PlanningFinalMoment",
      "type": "object"
    },
    "PlanningHostFunction": {
      "additionalProperties": false,
      "properties": {
        "speaker_id": {
          "description": "Exact identifier from the assignment.",
          "minLength": 1,
          "title": "Speaker Id",
          "type": "string"
        },
        "contribution": {
          "minLength": 1,
          "title": "Contribution",
          "type": "string"
        },
        "interaction_guidance": {
          "minLength": 1,
          "title": "Interaction Guidance",
          "type": "string"
        },
        "speech_register": {
          "minLength": 1,
          "title": "Speech Register",
          "type": "string"
        }
      },
      "required": [
        "speaker_id",
        "contribution",
        "interaction_guidance",
        "speech_register"
      ],
      "title": "PlanningHostFunction",
      "type": "object"
    },
