        "main_question": {
          "minLength": 1,
          "title": "Main Question",
          "type": "string"
        },
        "listener_promise": {
          "minLength": 1,
          "title": "Listener Promise",
          "type": "string"
        },
        "working_answer": {
          "description": "The episode-wide answer, stated as precisely as the reporting allows.",
          "minLength": 1,
          "title": "Working Answer",
          "type": "string"
        },
