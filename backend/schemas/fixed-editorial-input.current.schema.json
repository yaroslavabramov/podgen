          "description": "Exact locators offered in the supplied material catalog.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Material Refs",
          "type": "array"
        },
        "question_to_open": {
          "minLength": 1,
          "title": "Question To Open",
          "type": "string"
